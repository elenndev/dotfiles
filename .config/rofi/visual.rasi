* {
    font: "JetBrainsMono Nerd Font 11";

    /* Background */
    bg: rgba(17, 18, 20, 0.8);
    bg-surface: rgba(17, 18, 20, 1);
    bg-muted: rgba(17, 18, 20, 0.3);

    /* Text */
    fg: #c7c9cc;
    fg-muted: #777b82;

    /* Borders and states */
    border: rgba(119, 123, 130, 0.4);
    hover: rgba(17, 18, 20, 1);
    selected: rgba(17, 18, 20, 1);
}

window {
    width: 70%;

    background-color: @bg;

    border: 1px;
    border-color: @border;
    border-radius: 1px;

    padding: 20px;
}

mainbox {
    background-color: transparent;

    children: [
        inputbar,
        mode-switcher,
        listview
    ];

    spacing: 18px;
}

inputbar {
    background-color: @bg-surface;

    border-radius: 0px;

    padding: 10px 14px;

    children: [
        prompt,
        entry
    ];
}

prompt {
    background-color: transparent;

    text-color: @fg;

    padding: 0 8px 0 0;
}

entry {
    background-color: transparent;

    text-color: @fg;

    placeholder: "Pesquisar...";
    placeholder-color: @fg-muted;
}

listview {
    background-color: transparent;

    columns: 5;
    lines: 2;

    spacing: 12px;

    cycle: true;
    dynamic: true;
}

element {
    background-color: transparent;

    border-radius: 0px;

    padding: 10px;

    orientation: horizontal;

    /* Display only the text */
    children: [
        element-text
    ];

    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element selected {
    background-color: @selected;

    border: 1px;
    border-color: @fg-muted;
}

element-icon {
    size: 20px;

    background-color: transparent;
}

element-text {
    background-color: transparent;

    text-color: @fg;

    horizontal-align: 0.5;
    vertical-align: 0.5;

    padding: 0;
}

mode-switcher {
    background-color: transparent;

    spacing: 0px;
}

button {
    background-color: transparent;

    text-color: @fg-muted;

    padding: 8px 16px;
}

button selected {
    background-color: @selected;

    text-color: @fg;

    border: 1px;
    border-color: @fg-muted;
}
